# Auto-updater configuration for Fantasy Life PC (Windows + Linux)
# 1. Git remote branch (used when 'git' is installed):
FL_UPDATE_BRANCH=main

# 2. Gitless fallback ZIP URL (used when 'git' is not installed on a brother's PC):
FL_UPDATE_ZIP_URL=https://github.com/LAURlN/fl-project-blue/archive/refs/heads/main.zip

# 3. Optional raw version.json URL used to skip downloads when nothing changed.
#    It is derived automatically for GitHub archive ZIP URLs; set it explicitly
#    for other ZIP hosts:
# FL_UPDATE_VERSION_URL=https://raw.githubusercontent.com/LAURlN/fl-project-blue/main/version.json
